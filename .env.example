# Local setup script creates .env with a random password. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:55432/cinereserve"
CATALOGUE_SOURCE="database"
# Optional development-only admin alias; ignored in production and non-local databases.
ALLOW_LOCAL_ADMIN_LOGIN=false

# Server-only Google Gemini integration. Never use NEXT_PUBLIC_ for API keys.
# Enable after placing your own key locally. No key means a clear search fallback.
CHATBOT_ENABLED=false
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# Maximum chatbot requests across all visitors in a rolling 24-hour window.
# Normally one model call; one transient 503 retry may occur within the same timeout.
# Failed/stopped requests also consume the request cap.
CHATBOT_DAILY_REQUEST_LIMIT=100
